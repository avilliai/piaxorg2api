# Piax2API service
HOST=0.0.0.0
PORT=8001
RELOAD=False
API_KEY=endlesswork
TOKEN_FILE=data/tokens.json
KEEP_ALIVE_MINUTES=150
LOG_LEVEL=INFO

# Chat retry policy
CHAT_MAX_RETRIES=5
CHAT_RETRY_DELAY=2
CHAT_RETRY_DELAY_MAX=10

# Temporary email provider used by registration
WORKER_DOMAIN=
EMAIL_DOMAIN=
ADMIN_PASSWORD=
EMAIL_MODE=outlook #worker/outlook
OUTLOOK_ACCOUNT_FILE=OUT-20260728-S1000-00082.txt
OUTLOOK_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
OUTLOOK_IMAP_HOST=outlook.office365.com
OUTLOOK_IMAP_PORT=993

# Registration worker settings
THREADS=2
POLL_TIMEOUT=100
POLL_INTERVAL=5
SLEEP_INTERVAL=10
REGISTER_RETRY_DELAY=5

# Optional sharing of newly-created tokens
SHARE_ENABLED=False
SHARE_BATCH_SIZE=2
SHARE_URL=http://localhost:8001/admin/tokens/add
SHARE_BEARER_KEY=endlesswork

# Piax API endpoint override
PIAX_API_URL=https://piax-api.piax.org
